#[builtin]
struct Unit {}

#[builtin]
type Runtime

#[builtin]
type I64

#[builtin]
fn print_i64(value: I64, runtime: Runtime)

#[builtin]
fn transmute(type T, type U, value: T) -> U

struct Erased(type(dyn T) Type) {
    value: Type(Unit),
}

fn erase(type(dyn U) Type, type T, value: Type(T)) -> Erased(Type) {
    Erased(Type) {
        value: transmute(Type(T), Type(Unit), value),
    }
}

fn access(type(dyn T) Type, erased: Erased(Type), callback: fn(dyn U, value: Type(U))) {
    callback(Unit, erased.value)
}

fn main(runtime: Runtime) -> Unit {
    print_i64(5, runtime)

    let variable: I64 = 6
    print_i64(variable, runtime)

    struct Stuff(dyn T) {}

    let erased: Erased(Stuff) = erase(Stuff, I32, Stuff(I32) {})
    access(Stuff, erased, fn(dyn U, value: Stuff(U)) {})
}
