#[builtin]
struct Unit {}

#[builtin]
type Runtime

#[builtin]
type I64

#[builtin]
fn print_i64(value: I64, runtime: Runtime)

#[builtin]
unsafe fn transmute(type T, type U, value: T) -> U

struct Erased(type(dyn T) Type) {
    value: Type(type Unit),
}

fn erase(type(dyn U) Type, type T, value: Type(type T)) -> Erased(type(dyn U) Type(dyn U)) {
    Erased(type(dyn U) Type(dyn U)) {
        // SAFETY: Type has a dyn type parameter, so its memory layout does not depend on the type passed in,
        // so transmuting Type(T) to Type(Unit) here is fine since they have the same memory layout
        value: unsafe { transmute(type Type(type T), type Type(type Unit), value) },
    }
}

fn access(type(dyn T) Type, erased: Erased(type(dyn T) Type(dyn T)), callback: fn(dyn U, value: Type(dyn U))) {
    callback(type Unit, erased.value)
}

fn main(runtime: Runtime) -> Unit {
    print_i64(5, runtime)

    let variable: I64 = 6
    print_i64(variable, runtime)

    struct Stuff(dyn T) {}

    let erased: Erased(type(dyn T) Stuff(dyn T)) = erase(type(dyn T) Stuff(dyn T), type I64, Stuff(type I64) {})
    access(type(dyn T) Stuff(dyn T), erased, fn(dyn U, value: Stuff(dyn U)) {})
}
